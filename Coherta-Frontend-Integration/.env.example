# Proposed integration settings. Values below are placeholders, not credentials.
# The original PHP/JS snapshot does NOT automatically read this file.
# Implement configuration loading in the selected host/server adapter.
INTEGRATION_VERSION=
INTEGRATION_DATA_MODE=mock
APP_NAME=
APP_PUBLIC_ORIGIN=http://localhost:3000
APP_BASE_PATH=/outreach
BRAND_PRIMARY_COLOR=
BRAND_ACCENT_COLOR=
BRAND_LOGO_URL=
BRAND_DARK_LOGO_URL=
BRAND_FAVICON_URL=
DEFAULT_LOCALE=en
DEFAULT_TIMEZONE=UTC
HOST_PLATFORM_ORIGIN=
HOST_RETURN_PATH=
ALLOWED_PARENT_ORIGINS=
AUTH_MODE=
COHERTA_API_BASE_URL=
# Partner attribution settings; confirm values separately for each environment.
# Resolve these server-side and verify the backend's exact registration contract.
# COHERTA_PARTNER_ID is NOT a LinkedIn ads partner ID or an API credential.
COHERTA_PARTNER_ID=
PARTNER_SIGNUP_MODE=
PARTNER_SIGNUP_RETURN_PATH=
# Keep real registration disabled until partner attribution is verified.
PARTNER_SIGNUP_ENABLED=false
# Set runtime credentials in a server-side secret store after the auth contract
# is agreed. Do not use a browser-visible token or a shared global tenant identity.
COHERTA_CREDENTIAL_SECRET_REF=
ENABLE_LEAD_MONITORING=
ENABLE_WORKFLOW=
ENABLE_MESSAGES=
ENABLE_STATISTICS=
